// Database schema for Retain. After changing it, run: npm run db:migrate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum PaymentMethod {
  cash
  card
  mobile_money
  bank_transfer
  other
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(80)
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses Expense[]
  budgets  Budget[]
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(40)
  /// The fallback category. It cannot be deleted, and expenses move to it when their category is deleted.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id            String        @id @default(uuid())
  title         String        @db.VarChar(120)
  amount        Decimal       @db.Decimal(12, 2)
  /// A calendar day with no time part, so month filters are not shifted by time zones.
  date          DateTime      @db.Date
  paymentMethod PaymentMethod
  notes         String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  /// Restrict: a category can only be deleted after its expenses have been moved elsewhere.
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Every list query is "this user's expenses, newest first", so index exactly that.
  @@index([userId, date(sort: Desc)])
  @@index([categoryId])
}

model Budget {
  id        String   @id @default(uuid())
  /// Calendar month in YYYY-MM format, e.g. "2026-10".
  month     String   @db.Char(7)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One budget per user per month.
  @@unique([userId, month])
}
